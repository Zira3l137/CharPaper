<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>CharPaper: third-party licenses</title>
<style>
body { margin: 0 auto; max-width: 860px; padding: 32px 20px; font: 15px/1.5 system-ui, sans-serif; color: #1d2027; background: #fff; }
h1 { font-size: 26px; } h2 { font-size: 20px; margin-top: 40px; } h3 { font-size: 17px; margin-top: 32px; }
pre { white-space: pre-wrap; font-size: 13px; background: #f4f5f7; padding: 16px; border-radius: 8px; }
ul.crates { columns: 2 260px; padding-left: 20px; }
@media (prefers-color-scheme: dark) { body { color: #e8ebf2; background: #0e1015; } pre { background: #181b23; } a { color: #8cc3f7; } }
</style>
</head>
<body>
<h1>Third-party licenses</h1>
<p>CharPaper is built from these libraries, under these licenses. Thank you to everyone who made them.</p>
<h2>Licenses</h2>
<ul>
{{#each overview}}<li><a href="#{{id}}">{{name}}</a>: {{count}}</li>
{{/each}}</ul>
<h2>Texts, and who uses each</h2>
{{#each licenses}}<h3 id="{{id}}">{{name}}</h3>
<ul class="crates">
{{#each used_by}}<li><a href="{{#if crate.repository}}{{crate.repository}}{{else}}https://crates.io/crates/{{crate.name}}{{/if}}">{{crate.name}} {{crate.version}}</a></li>
{{/each}}</ul>
<pre>{{text}}</pre>
{{/each}}</body>
</html>
